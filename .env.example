# Server-side only. These are read by the functions in /api and are never
# bundled into the browser. Set them in Vercel → Settings → Environment
# Variables, then REDEPLOY — adding a variable does not update a running build.

# Guideline Q&A panel (/api/chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Feasibility feedback form (/api/feedback)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
