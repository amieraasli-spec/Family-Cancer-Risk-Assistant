# IKN Medical Report Tracking & Performance System — prototype configuration
# Copy to .env. No real credentials belong in this file or in any frontend bundle.

# --- Server ---
PORT=4180
NODE_ENV=development

# Where the prototype database file lives. The production target is PostgreSQL;
# see docs/11-integration-notes.md for the DATABASE_URL form.
IKN_DB_FILE=var/ikn.sqlite

# 32-byte hex secret used to HMAC public tracking tokens and session ids at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IKN_TOKEN_PEPPER=replace-me-with-64-hex-characters

# --- Data class banner ---
# SYNTHETIC keeps the "Demonstration data — not actual IKN performance" label on
# every page and every export. Only IKN may set this to LIVE, and only after the
# items in docs/12-open-items-for-live-use.md are closed.
IKN_DATA_CLASS=SYNTHETIC

# --- Messaging adapter ---
# SIMULATION writes notifications to the database and never contacts a network.
IKN_NOTIFY_PROVIDER=SIMULATION
# Comma-separated allowlist of destinations the adapter may ever send to.
# Anything outside this list is refused, so a test run cannot reach a real patient.
IKN_NOTIFY_TEST_ALLOWLIST=records.test@example.invalid
